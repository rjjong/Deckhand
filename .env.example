HOST=127.0.0.1
PORT=3000
# Docker's published interface; use 0.0.0.0 only for intentional LAN access.
BIND_ADDRESS=127.0.0.1
# Native Node paths. Compose uses its own persistent volume instead.
DATABASE_PATH=./var/deckhand.dev.sqlite
# Small, explicitly downloaded sample. Missing files are never fetched.
DATA_DIR=./var/data-sample

# Optional accounts use this exact public origin for verification/reset links.
# Use HTTPS in production. These credentials belong only in the private .env.
PUBLIC_URL=http://localhost:3000
EMAIL_FROM=Deckhand <accounts@mtgdeckhand.com>
RESEND_API_KEY=
# Set to 1 behind the Docker Cloudflare Tunnel for visitor rate limits.
TRUST_CLOUDFLARE_PROXY=0

# Local inference only. Native development: run Ollama on this computer.
# Docker Compose connects to its private ollama service automatically.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_MS=75000
# App request limits protect the server's inference capacity.
JUDGE_DAILY=20
JUDGE_GLOBAL=800
