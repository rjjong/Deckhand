HOST=127.0.0.1
PORT=3000
# Docker's published interface; use 0.0.0.0 only for intentional LAN access.
BIND_ADDRESS=127.0.0.1
# Native Node paths. Compose uses its own persistent volume instead.
DATABASE_PATH=./var/deckhand.dev.sqlite
# Small, explicitly downloaded sample. Missing files are never fetched.
DATA_DIR=./var/data-sample

# Ask AI Judge uses Groq only. Create a key at https://console.groq.com/keys
# Keep the Groq account on its Free plan; billing tier is controlled by Groq.
# Put real keys only in .env, never in the browser, settings, or Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# App request limits, separate from Groq's request/token quotas.
JUDGE_DAILY=20
JUDGE_GLOBAL=800

# Optional other providers for deck advice, not Ask AI Judge.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
