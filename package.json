{
  "name": "deckhand",
  "private": true,
  "description": "Deckhand PWA with a self-hosted Node.js and SQLite server.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:download": "node --env-file-if-exists=.env scripts/download-library.mjs",
    "data:library": "node --env-file-if-exists=.env scripts/download-library.mjs",
    "test:mobile": "playwright test",
    "data:sample": "node --env-file-if-exists=.env scripts/download-data.mjs",
    "env:check": "node scripts/dev-environment.mjs check",
    "db:init": "node --env-file-if-exists=.env scripts/dev-environment.mjs db:init",
    "db:check": "node --env-file-if-exists=.env scripts/dev-environment.mjs db:check"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
